{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "termux-bridge",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_QUEUE",
        "class_name": "TaskQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TaskQueue"]
    }
  ]
}
